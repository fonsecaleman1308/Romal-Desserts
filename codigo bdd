-- BASE DE DATOS: romale_desserts
-- Para MySQL / XAMPP (phpMyAdmin, pestaña SQL)
-- Solo se usan los tipos INT y VARCHAR.
-- Las fechas se guardan como texto (VARCHAR) con formato AAAA-MM-DD.
-- Los precios se guardan como números enteros (pesos colombianos).
-- ============================================================


-- ============================================================
-- 1. CREACIÓN DE LA BASE DE DATOS
-- ============================================================
-- Si la base ya existe en tu XAMPP y quieres empezar de cero,
-- quita los dos guiones de la siguiente línea (esto BORRA todo lo que tenga):
-- DROP DATABASE IF EXISTS romale_desserts;

CREATE DATABASE romale_desserts CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;


-- ============================================================
-- 2. SELECCIÓN DE LA BASE DE DATOS
-- ============================================================
USE romale_desserts;


-- ============================================================
-- 3. CREACIÓN DE LAS TABLAS
-- Primero las tablas que no dependen de otras y después
-- las que tienen llaves foráneas.
-- ============================================================

CREATE TABLE roles (
    id_rol INT AUTO_INCREMENT PRIMARY KEY,
    nombre VARCHAR(50) NOT NULL,
    descripcion VARCHAR(150)
);

CREATE TABLE tipos_error (
    id_tipo_error INT AUTO_INCREMENT PRIMARY KEY,
    nombre VARCHAR(80) NOT NULL,
    descripcion VARCHAR(150)
);

CREATE TABLE `tamaños` (
    id_tamano INT AUTO_INCREMENT PRIMARY KEY,
    nombre VARCHAR(50) NOT NULL,
    medida VARCHAR(50),
    precio INT NOT NULL
);

CREATE TABLE sabores (
    id_sabor INT AUTO_INCREMENT PRIMARY KEY,
    nombre VARCHAR(50) NOT NULL,
    descripcion VARCHAR(150),
    precio_adicional INT NOT NULL
);

CREATE TABLE toppings (
    id_topping INT AUTO_INCREMENT PRIMARY KEY,
    nombre VARCHAR(50) NOT NULL,
    descripcion VARCHAR(150),
    precio INT NOT NULL
);

CREATE TABLE extras (
    id_extra INT AUTO_INCREMENT PRIMARY KEY,
    nombre VARCHAR(50) NOT NULL,
    descripcion VARCHAR(150),
    precio INT NOT NULL
);

CREATE TABLE ingredientes (
    id_ingrediente INT AUTO_INCREMENT PRIMARY KEY,
    nombre VARCHAR(60) NOT NULL,
    unidad_medida VARCHAR(20) NOT NULL,
    stock_actual INT NOT NULL,
    stock_minimo INT NOT NULL
);

CREATE TABLE clientes (
    id_cliente INT AUTO_INCREMENT PRIMARY KEY,
    nombre_completo VARCHAR(100) NOT NULL,
    correo VARCHAR(100) NOT NULL,
    usuario VARCHAR(30) NOT NULL,
    contrasena VARCHAR(50) NOT NULL,
    telefono VARCHAR(20),
    direccion VARCHAR(150)
);

CREATE TABLE clientes_internos (
    id_interno INT AUTO_INCREMENT PRIMARY KEY,
    id_rol INT NOT NULL,
    nombre_completo VARCHAR(100) NOT NULL,
    correo VARCHAR(100) NOT NULL,
    usuario VARCHAR(30) NOT NULL,
    contrasena VARCHAR(50) NOT NULL,
    telefono VARCHAR(20),
    FOREIGN KEY (id_rol) REFERENCES roles(id_rol)
);

CREATE TABLE pedidos (
    id_pedido INT AUTO_INCREMENT PRIMARY KEY,
    codigo_pedido VARCHAR(20) NOT NULL,
    id_cliente INT NOT NULL,
    fecha_pedido VARCHAR(20) NOT NULL,
    estado VARCHAR(20) NOT NULL,
    costo_envio INT NOT NULL,
    total INT NOT NULL,
    direccion_entrega VARCHAR(150),
    FOREIGN KEY (id_cliente) REFERENCES clientes(id_cliente)
);

CREATE TABLE cheesecakes_personalizados (
    id_cheesecake INT AUTO_INCREMENT PRIMARY KEY,
    id_tamano INT NOT NULL,
    id_sabor INT NOT NULL,
    nombre VARCHAR(80) NOT NULL,
    descripcion VARCHAR(200),
    precio INT NOT NULL,
    FOREIGN KEY (id_tamano) REFERENCES `tamaños`(id_tamano),
    FOREIGN KEY (id_sabor) REFERENCES sabores(id_sabor)
);

-- Tabla intermedia: qué toppings lleva cada cheesecake
CREATE TABLE cheesecake_toppings (
    id_cheesecake INT NOT NULL,
    id_topping INT NOT NULL,
    cantidad INT NOT NULL,
    PRIMARY KEY (id_cheesecake, id_topping),
    FOREIGN KEY (id_cheesecake) REFERENCES cheesecakes_personalizados(id_cheesecake),
    FOREIGN KEY (id_topping) REFERENCES toppings(id_topping)
);

-- Tabla intermedia: qué extras lleva cada cheesecake
CREATE TABLE cheesecake_extras (
    id_cheesecake INT NOT NULL,
    id_extra INT NOT NULL,
    cantidad INT NOT NULL,
    PRIMARY KEY (id_cheesecake, id_extra),
    FOREIGN KEY (id_cheesecake) REFERENCES cheesecakes_personalizados(id_cheesecake),
    FOREIGN KEY (id_extra) REFERENCES extras(id_extra)
);

CREATE TABLE detalle_pedido (
    id_detalle INT AUTO_INCREMENT PRIMARY KEY,
    id_pedido INT NOT NULL,
    id_cheesecake INT NOT NULL,
    cantidad INT NOT NULL,
    precio_unitario INT NOT NULL,
    subtotal INT NOT NULL,
    FOREIGN KEY (id_pedido) REFERENCES pedidos(id_pedido),
    FOREIGN KEY (id_cheesecake) REFERENCES cheesecakes_personalizados(id_cheesecake)
);

CREATE TABLE devoluciones (
    id_devolucion INT AUTO_INCREMENT PRIMARY KEY,
    id_pedido INT NOT NULL,
    id_interno INT NOT NULL,
    motivo VARCHAR(150) NOT NULL,
    fecha_devolucion VARCHAR(20) NOT NULL,
    estado VARCHAR(20) NOT NULL,
    monto_reembolsado INT NOT NULL,
    FOREIGN KEY (id_pedido) REFERENCES pedidos(id_pedido),
    FOREIGN KEY (id_interno) REFERENCES clientes_internos(id_interno)
);

CREATE TABLE errores_pedido (
    id_error INT AUTO_INCREMENT PRIMARY KEY,
    id_tipo_error INT NOT NULL,
    id_pedido INT NOT NULL,
    id_interno INT NOT NULL,
    descripcion VARCHAR(200) NOT NULL,
    fecha_error VARCHAR(20) NOT NULL,
    estado VARCHAR(20) NOT NULL,
    FOREIGN KEY (id_tipo_error) REFERENCES tipos_error(id_tipo_error),
    FOREIGN KEY (id_pedido) REFERENCES pedidos(id_pedido),
    FOREIGN KEY (id_interno) REFERENCES clientes_internos(id_interno)
);

CREATE TABLE movimientos_inventario (
    id_movimiento INT AUTO_INCREMENT PRIMARY KEY,
    id_ingrediente INT NOT NULL,
    id_interno INT NOT NULL,
    tipo_movimiento VARCHAR(20) NOT NULL,
    cantidad INT NOT NULL,
    fecha_movimiento VARCHAR(20) NOT NULL,
    observacion VARCHAR(150),
    FOREIGN KEY (id_ingrediente) REFERENCES ingredientes(id_ingrediente),
    FOREIGN KEY (id_interno) REFERENCES clientes_internos(id_interno)
);


