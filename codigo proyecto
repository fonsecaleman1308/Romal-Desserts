    // ---------- 3. Carrito ----------
    static void cartView(JPanel p) {
        p.add(header("Tu Carrito", "Revisa tus cheesecakes antes de pagar"), BorderLayout.NORTH);
        if (cart.isEmpty()) { empty(p, "Tu carrito está vacío", "Ver catálogo", "catalog"); return; }
        JPanel rows = col(); rows.setBorder(new EmptyBorder(6, 30, 20, 12));
        for (Item it : new ArrayList<>(cart)) {
            RP r = new RP(CARD, 24); r.setLayout(new BorderLayout(14, 0)); r.setBorder(new EmptyBorder(10, 12, 10, 16)); r.setMaximumSize(new Dimension(Integer.MAX_VALUE, 100));
            r.add(new JLabel(img(it.img, 96, 76)), BorderLayout.WEST);
            JPanel mid = col(); mid.add(L(it.name, F(1, 15), WHITE)); mid.add(L("<html><div style='width:330px'>" + it.detail + "</div></html>", F(0, 11), MUTED));
            JPanel east = new JPanel(new FlowLayout(FlowLayout.RIGHT, 8, 20)); east.setOpaque(false);
            Btn m = new Btn("-", new Color(60, 60, 70), false), pl = new Btn("+", new Color(60, 60, 70), false), x = new Btn("x", new Color(150, 50, 70), false);
            for (Btn b : new Btn[]{m, pl, x}) { b.setForeground(WHITE); b.setBorder(new EmptyBorder(4, 10, 4, 10)); }
            m.addActionListener(e -> { if (--it.qty <= 0) cart.remove(it); go("cart"); }); pl.addActionListener(e -> { it.qty++; go("cart"); }); x.addActionListener(e -> { cart.remove(it); go("cart"); });
            east.add(m); east.add(L("" + it.qty, F(1, 15), WHITE)); east.add(pl); east.add(L(money(it.price * it.qty), S(1, 20), GOLD)); east.add(x);
            r.add(mid, BorderLayout.CENTER); r.add(east, BorderLayout.EAST); rows.add(r); rows.add(gap(10));
        }
        p.add(sp(rows), BorderLayout.CENTER);
        RP side = card(24); 
        side.add(ctr(L("Resumen", S(1, 24), GOLD))); side.add(gap(18));
        side.add(line("Subtotal", money(subtotal()), WHITE)); side.add(line("Envío", money(ENVIO), WHITE)); side.add(gap(8)); side.add(line("Total", money(subtotal() + ENVIO), GOLD)); side.add(gap(22));
        Btn pay = ctr(new Btn("Proceder al pago", PINK, false)), more = ctr(new Btn("Seguir comprando", new Color(60, 60, 70), false)); more.setForeground(WHITE);
        pay.addActionListener(e -> go("payment")); more.addActionListener(e -> go("catalog")); side.add(pay); side.add(gap(10)); side.add(more);
        JPanel w = new JPanel(new BorderLayout()); w.setOpaque(false); w.setBorder(new EmptyBorder(6, 0, 24, 30)); w.setPreferredSize(new Dimension(340, 10)); w.add(side, BorderLayout.NORTH); p.add(w, BorderLayout.EAST);
    }
