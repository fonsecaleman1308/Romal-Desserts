            c.add(ctr(L("¡Hola, " + users.get(user)[1] + "!", S(1, 24), GOLD))); c.add(gap(8)); c.add(ctr(L("Tu sesión está activa", F(0, 14), MUTED))); c.add(gap(24));
            Btn out = ctr(new Btn("Cerrar sesión", PINK, false)); out.addActionListener(e -> { user = null; go("login"); }); c.add(out);
        } else {
            c.add(ctr(L("Bienvenida a Romale", S(1, 22), WHITE))); c.add(gap(14));
            JTextField u = field(c, "Usuario", false), pw = field(c, "Contraseña", true); c.add(gap(6));
            Btn in = ctr(new Btn("Ingresar", PINK, false)); Btn reg = ctr(new Btn("¿Nuevo aquí? Crea tu cuenta", GOLD, true)); reg.setForeground(GOLD);
            Runnable doIt = () -> { String[] d = users.get(u.getText().trim());
                if (d == null || !d[0].equals(new String(((JPasswordField) pw).getPassword()))) { say("Usuario o contraseña incorrectos."); return; }
                user = u.getText().trim(); seed(user); go(user.equals("admin") ? "admin" : "catalog"); };
            in.addActionListener(e -> doIt.run()); pw.addActionListener(e -> doIt.run()); reg.addActionListener(e -> go("register"));
            c.add(in); c.add(gap(8)); c.add(reg); c.add(gap(6)); c.add(ctr(L("Demo administrador: admin / admin123", F(0, 11), MUTED)));
        }
        p.add(centered(c), BorderLayout.CENTER);
