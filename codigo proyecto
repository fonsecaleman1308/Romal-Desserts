    static class RP extends JPanel {
        Color bg; int r;
        RP(Color bg, int r) { this.bg = bg; this.r = r; setOpaque(false); }
        protected void paintComponent(Graphics g) {
            Graphics2D g2 = (Graphics2D) g.create(); g2.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
            g2.setColor(bg); g2.fillRoundRect(0, 0, getWidth() - 1, getHeight() - 1, r, r);
            g2.setColor(new Color(212, 175, 55, 70)); g2.drawRoundRect(0, 0, getWidth() - 1, getHeight() - 1, r, r); g2.dispose(); super.paintComponent(g);
        }
    }
    static class Btn extends JButton {
        Color c; boolean flat, active;
        Btn(String t, Color c, boolean flat) {
            super(t); this.c = c; this.flat = flat; setContentAreaFilled(false); setBorderPainted(false); setFocusPainted(false); setOpaque(false);
            setFont(F(1, flat ? 13 : 14)); setBorder(new EmptyBorder(flat ? 8 : 10, flat ? 12 : 22, flat ? 8 : 10, flat ? 12 : 22));
            setCursor(Cursor.getPredefinedCursor(Cursor.HAND_CURSOR)); setForeground(flat ? WHITE : new Color(20, 20, 20));
        }
        void setActive(boolean a) { active = a; setForeground(a ? PINK : WHITE); repaint(); }
        protected void paintComponent(Graphics g) {
            Graphics2D g2 = (Graphics2D) g.create(); g2.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
            Color b = flat ? (active ? new Color(232, 135, 159, 45) : getModel().isRollover() ? new Color(255, 255, 255, 25) : null) : (getModel().isRollover() ? c.brighter() : c);
            if (b != null) { g2.setColor(b); g2.fillRoundRect(0, 0, getWidth() - 1, getHeight() - 1, 22, 22); }
            g2.dispose(); super.paintComponent(g);
        }
    }

    // ---------- lógica ----------
    static void addCart(String name, String im, int price, String detail) {
        for (Item i : cart) if (i.name.equals(name) && i.detail.equals(detail)) { i.qty++; refreshNav(); return; }
        Item i = new Item(); i.name = name; i.img = im; i.price = price; i.detail = detail; i.qty = 1; cart.add(i); refreshNav();
    }
    static int subtotal() { int s = 0; for (Item i : cart) s += i.price * i.qty; return s; }
    static void refreshNav() {
        int n = 0; for (Item i : cart) n += i.qty;
        nav.get("cart").setText("Carrito" + (n > 0 ? " (" + n + ")" : ""));
        nav.get("login").setText(user == null ? "Login" : "Cuenta: " + user);
    }
    static void seed(String u) {
        for (String[] o : orders) if (o[1].equals(u)) return;
        String[][] d = {{"RD-0912", "12/08/2026", "1x Cheesecake Oreo", "12000", "Entregado"}, {"RD-0947", "29/08/2026", "1x Cheesecake Maracuyá, 1x Cheesecake Limón", "22000", "Entregado"},
                {"RD-0981", "18/09/2026", "1x Cheesecake personalizado Mediano", "19500", "Entregado"}};
        for (String[] x : d) orders.add(new String[]{x[0], u, x[1], x[2], x[3], x[4]});
    }
    static void go(String n) {
        builders.get(n).run(); cl.show(content, n); for (Map.Entry<String, Btn> e : nav.entrySet()) e.getValue().setActive(e.getKey().equals(n)); refreshNav();
    }

