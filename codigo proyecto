    // ---------- 5. Registro ----------
    static void register(JPanel p) {
        p.add(header("Crear cuenta", "Únete a la dulce experiencia Romale Desserts"), BorderLayout.NORTH);
        RP c = card(30); c.setPreferredSize(new Dimension(440, 600));
        JTextField n = field(c, "Nombre completo", false), m = field(c, "Correo electrónico", false), u = field(c, "Usuario", false),
                a = field(c, "Contraseña (mín. 4 caracteres)", true), b = field(c, "Confirmar contraseña", true);
        c.add(gap(6)); Btn ok = ctr(new Btn("Crear mi cuenta", PINK, false)); Btn back = ctr(new Btn("Ya tengo cuenta", GOLD, true)); back.setForeground(GOLD);
        ok.addActionListener(e -> {
            String us = u.getText().trim(), p1 = new String(((JPasswordField) a).getPassword()), p2 = new String(((JPasswordField) b).getPassword());
            if (n.getText().trim().isEmpty() || us.isEmpty() || p1.isEmpty()) { say("Completa todos los campos."); return; }
            if (!m.getText().matches("[^@\\s]+@[^@\\s]+\\.[^@\\s]+")) { say("Ingresa un correo válido."); return; }
            if (p1.length() < 4) { say("La contraseña debe tener al menos 4 caracteres."); return; }
            if (!p1.equals(p2)) { say("Las contraseñas no coinciden."); return; }
            if (users.containsKey(us)) { say("Ese usuario ya existe. Elige otro."); return; }
            users.put(us, new String[]{p1, n.getText().trim(), m.getText().trim()}); say("¡Cuenta creada! Ahora inicia sesión."); go("login");
        });
        back.addActionListener(e -> go("login")); c.add(ok); c.add(gap(8)); c.add(back); p.add(centered(c), BorderLayout.CENTER);
    }

