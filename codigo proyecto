        p.add(header("Pago", "Elige tu medio de pago (simulado)"), BorderLayout.NORTH);
        if (cart.isEmpty()) { empty(p, "No hay productos para pagar", "Ver catálogo", "catalog"); return; }
        String[] meth = {"Tarjeta crédito / débito", "Nequi", "Daviplata", "PSE - Transferencia bancaria", "Efectivo contra entrega"};
        RP left = card(24); left.add(L("Medio de pago", S(1, 22), GOLD)); left.add(gap(8));
        ButtonGroup g = new ButtonGroup(); JRadioButton[] rb = new JRadioButton[5];
        JPanel cf = col(), ph = col(); cf.setAlignmentX(0); ph.setAlignmentX(0);
        JTextField num = field(cf, "Número de tarjeta", false), nom = field(cf, "Nombre del titular", false), exp = field(cf, "Vencimiento (MM/AA)", false), cvv = field(cf, "CVV", true),
                cel = field(ph, "Número de celular", false); ph.setVisible(false);
        for (int i = 0; i < 5; i++) { final int k = i; rb[i] = sty(new JRadioButton(meth[i])); rb[i].setFont(F(1, 15)); g.add(rb[i]); left.add(rb[i]);
            rb[i].addActionListener(e -> { cf.setVisible(k == 0); ph.setVisible(k == 1 || k == 2); }); }
        rb[0].setSelected(true); left.add(gap(10)); left.add(cf); left.add(ph);
        RP right = card(24); right.add(ctr(L("Resumen del pedido", S(1, 22), GOLD))); right.add(gap(12));
        for (Item it : cart) right.add(line(it.qty + "x " + it.name.replace("Cheesecake ", ""), money(it.price * it.qty), WHITE));
        right.add(gap(8)); right.add(line("Envío", money(ENVIO), MUTED)); right.add(line("Total", money(subtotal() + ENVIO), GOLD)); right.add(gap(20));
        Btn ok = ctr(new Btn("Confirmar pago", PINK, false)); right.add(ok);
        ok.addActionListener(e -> {
            if (user == null) { say("Inicia sesión para completar tu compra."); go("login"); return; }
            int idx = 0; for (int i = 0; i < 5; i++) if (rb[i].isSelected()) idx = i;
            if (idx == 0 && (num.getText().replaceAll("\\s", "").length() != 16 || nom.getText().trim().isEmpty() || !exp.getText().matches("\\d\\d/\\d\\d") || new String(((JPasswordField) cvv).getPassword()).length() != 3)) { say("Revisa los datos de la tarjeta (16 dígitos, vencimiento MM/AA, CVV de 3 dígitos)."); return; }
            if ((idx == 1 || idx == 2) && !cel.getText().matches("\\d{10}")) { say("Ingresa un celular de 10 dígitos."); return; }
            StringBuilder sb = new StringBuilder(); for (Item it : cart) sb.append(sb.length() > 0 ? ", " : "").append(it.qty).append("x ").append(it.name);
            String id = "RD-" + (1000 + orders.size() + 1);
            orders.add(new String[]{id, user, new SimpleDateFormat("dd/MM/yyyy").format(new Date()), sb.toString(), "" + (subtotal() + ENVIO), "En preparación"});
            cart.clear(); say("¡Pago exitoso (simulado)!\nPedido " + id + " · " + meth[idx]); go("orders");
        });
        JPanel body = new JPanel(new GridLayout(1, 2, 22, 0)); body.setOpaque(false); body.setBorder(new EmptyBorder(6, 30, 24, 30)); body.add(left);
        JPanel w = new JPanel(new BorderLayout()); w.setOpaque(false); w.add(right, BorderLayout.NORTH); body.add(w); p.add(sp(body), BorderLayout.CENTER);
    }

    // ---------- 8. Panel administrativo ----------
    static void admin(JPanel p) {
        p.add(header("Panel Administrativo", "Control y gestión de Romale Desserts"), BorderLayout.NORTH);
        if (!"admin".equals(user)) { empty(p, "Acceso restringido: ingresa como administrador", "Ir a Login", "login"); return; }
        int sales = 0; for (String[] o : orders) sales += Integer.parseInt(o[4]);
        JPanel stats = new JPanel(new GridLayout(1, 4, 16, 0)); stats.setOpaque(false); stats.setBorder(new EmptyBorder(6, 30, 12, 30));
        String[][] s = {{"Pedidos", "" + orders.size()}, {"Ventas", money(sales)}, {"Clientes", "" + (users.size() - 1)}, {"Sabores", "5"}};
        for (String[] x : s) { RP c = card(16); c.add(ctr(L(x[0], F(0, 13), MUTED))); c.add(ctr(L(x[1], S(1, 28), GOLD))); stats.add(c); }
        DefaultTableModel pm = new DefaultTableModel(new String[]{"Sabor", "Precio (COP)"}, 0) { public boolean isCellEditable(int r, int c) { return c == 1; } };
        for (int i = 0; i < 5; i++) pm.addRow(new Object[]{NAMES[i], PR[i]});
        DefaultTableModel om = new DefaultTableModel(new String[]{"ID", "Cliente", "Total", "Estado"}, 0) { public boolean isCellEditable(int r, int c) { return false; } };
        for (String[] o : orders) om.addRow(new Object[]{o[0], o[1], money(Integer.parseInt(o[4])), o[5]});
        JTable pt = table(pm), ot = table(om);
        RP a = card(18), b = card(18);
        a.add(L("Catálogo y precios", S(1, 20), PINK)); a.add(gap(8)); a.add(tsp(pt)); a.add(gap(10));
        Btn sv = new Btn("Guardar precios", PINK, false); sv.setAlignmentX(0); sv.addActionListener(e -> {
            if (pt.isEditing()) pt.getCellEditor().stopCellEditing();
            try { for (int i = 0; i < 5; i++) PR[i] = Integer.parseInt(pm.getValueAt(i, 1).toString().replaceAll("[^0-9]", "")); say("Precios actualizados."); }
            catch (Exception ex) { say("Ingresa solo números."); } });
        a.add(sv);
        b.add(L("Pedidos", S(1, 20), PINK)); b.add(gap(8)); b.add(tsp(ot)); b.add(gap(10));
        Btn nx = new Btn("Avanzar estado", PINK, false); nx.setAlignmentX(0); nx.addActionListener(e -> {
            int r = ot.getSelectedRow(); if (r < 0) { say("Selecciona un pedido."); return; }
            String[] flow = {"Recibido", "En preparación", "En camino", "Entregado"}; String[] o = orders.get(r); int i = Arrays.asList(flow).indexOf(o[5]);
            o[5] = flow[Math.min(3, i + 1)]; om.setValueAt(o[5], r, 3); });
        b.add(nx);
        JPanel grid = new JPanel(new GridLayout(1, 2, 16, 0)); grid.setOpaque(false); grid.setBorder(new EmptyBorder(0, 30, 24, 30)); grid.add(a); grid.add(b);
        JPanel top = new JPanel(new BorderLayout()); top.setOpaque(false); top.add(stats, BorderLayout.NORTH); top.add(grid, BorderLayout.CENTER); p.add(top, BorderLayout.CENTER);
    }

    // ---------- arranque ----------
    static void reg(String key, String label, Consumer1 fn, JPanel bar) {
        JPanel v = new JPanel(new BorderLayout()); v.setBackground(BG); views.put(key, v); content.add(v, key);
        builders.put(key, () -> { v.removeAll(); fn.build(v); v.revalidate(); v.repaint(); });
        Btn b = new Btn(label, WHITE, true); b.addActionListener(e -> go(key)); nav.put(key, b); bar.add(b);
    }
    interface Consumer1 { void build(JPanel p); }

    public static void main(String[] args) { SwingUtilities.invokeLater(Main::start); }
    static JPanel buildUI() {
        try { UIManager.setLookAndFeel(UIManager.getCrossPlatformLookAndFeelClassName()); } catch (Exception e) { }
        UIManager.put("Panel.background", BG); UIManager.put("OptionPane.background", BG); UIManager.put("OptionPane.messageForeground", WHITE);
        UIManager.put("ScrollBar.thumb", new Color(70, 70, 80)); UIManager.put("ScrollBar.track", BG);
        users.put("admin", new String[]{"admin123", "Administrador", "admin@romale.com"});
        seed("cliente_demo");
        JPanel root = new JPanel(new BorderLayout()); root.setBackground(BG);
        JPanel top = new JPanel(new BorderLayout()); top.setBackground(new Color(9, 9, 11)); top.setBorder(new CompoundBorder(new MatteBorder(0, 0, 1, 0, new Color(212, 175, 55, 120)), new EmptyBorder(6, 18, 6, 14)));
        JPanel brand = new JPanel(new FlowLayout(FlowLayout.LEFT, 8, 0)); brand.setOpaque(false); brand.add(new JLabel(img("logo", 52, 52)));
        JPanel bt = col(); bt.add(L("Romale", S(1, 22), GOLD)); bt.add(L("D E S S E R T S", F(1, 10), PINK)); brand.add(bt); top.add(brand, BorderLayout.WEST);
        JPanel bar = new JPanel(new FlowLayout(FlowLayout.RIGHT, 2, 10)); bar.setOpaque(false); top.add(bar, BorderLayout.EAST);
        reg("catalog", "Catálogo", Main::catalog, bar); reg("custom", "Personalizar", Main::custom, bar); reg("cart", "Carrito", Main::cartView, bar);
        reg("orders", "Mis pedidos", Main::ordersView, bar); reg("login", "Login", Main::login, bar); reg("register", "Registro", Main::register, bar);
        reg("payment", "Pago", Main::payment, bar); reg("admin", "Admin", Main::admin, bar);
        root.add(top, BorderLayout.NORTH); root.add(content, BorderLayout.CENTER);
        go("catalog"); return root;
    }
    static void start() {
        frame = new JFrame("Romale Desserts"); frame.setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE); frame.setIconImage(img("logo", 64, 64).getImage());
        frame.setContentPane(buildUI());
        frame.setSize(1300, 820); frame.setMinimumSize(new Dimension(1180, 720)); frame.setLocationRelativeTo(null); frame.setVisible(true);
    }
